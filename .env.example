# xAI / Grok (voice + image understanding)
XAI_API_KEY=

# Photon 2.0 messaging
PHOTON_API_KEY=
PHOTON_PROJECT_ID=

# Factory Droid (only needed for non-local auth; local `droid login` preferred)
FACTORY_API_KEY=

# Chalk (service token from dashboard Settings > Service Tokens)
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT=          # env id, e.g. fttyeb5a005e (not the display name)
# CHALK_API_SERVER=         # only for isolated/self-hosted deployments

# Daytona sandboxes (FR-6)
DAYTONA_API_KEY=
DAYTONA_API_URL=            # https://app.daytona.io/api or org-specific
# DAYTONA_TARGET=           # optional region override
