# xAI / Grok (voice realtime + optional crop analysis)
# Get a key at https://console.x.ai — put it here, then smoke-test:
#   curl https://api.x.ai/v1/responses \
#     -H "Content-Type: application/json" \
#     -H "Authorization: Bearer $XAI_API_KEY" \
#     -d '{"model":"grok-4.7","input":"ping"}'
# Voice uses wss://api.x.ai/v1/realtime?model=grok-voice-latest (same key).
XAI_API_KEY=
# Optional image-understanding model override (Responses API, not Imagine):
# XAI_VISION_MODEL=grok-4.7

# Photon 2.0 messaging
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Reuse a private Photon echo-agent .env without copying its credentials:
# PHOTON_ENV_FILE=/absolute/path/to/private/photon.env
# Or configure the existing Beta iMessage assignment directly:
PHOTON_ASSIGNMENT_ID=
PHOTON_AGENT_HANDLE=
PHOTON_USER_HANDLE=
# PHOTON_TEST_SENDER=       # legacy echo-agent name for the same user handle
# PHOTON_SPACE_ID=          # optional, needed if multiple matching direct spaces exist

# Factory Droid (only needed for non-local auth; local `droid login` preferred)
FACTORY_API_KEY=
# Managed e2b Droid Computer id from POST /api/v0/computers (optional; local CLI if unset)
FACTORY_COMPUTER_ID=

# Chalk (service token from dashboard Settings > Service Tokens)
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT=          # env id, e.g. fttyeb5a005e (not the display name)
# CHALK_API_SERVER=         # only for isolated/self-hosted deployments
# CHALK_STATE_VOLUME=       # Chalk Volume for mission state (default: droid-mission-state)