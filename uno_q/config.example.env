# Copy to uno_q/config.env and edit. All keys also work as real env vars.

# --- Host relay ---
UNO_Q_HOST_IP=192.168.4.2
UNO_Q_HOST_URL=http://192.168.4.2:8787/telemetry
UNO_Q_HOST_PORT=8787
UNO_Q_WIFI_SSID=FieldHost

# --- Modes ---
UNO_Q_MOCK=0
UNO_Q_FORCE_OFFLINE=0
UNO_Q_FORCE_ONLINE=0
UNO_Q_FLUSH_BACKLOG=0
UNO_Q_OFFLINE_GRACE_S=3
UNO_Q_SAMPLE_HZ=1.0

# --- Sensors (MCU Bridge / mock) ---
UNO_Q_SENSOR_BACKEND=bridge
# UNO_Q_SENSOR_BACKEND=mock
UNO_Q_I2C_ADDR=0x76

# --- SD failover ---
UNO_Q_SD_DIR=/mnt/sd/apriltag_climate
# mock default: ./.uno_q_sd

# --- AprilTag autonomy (OFFLINE) ---
UNO_Q_APRILTAG_FAMILY=36h11
UNO_Q_APRILTAG_IDS=0,1,2
UNO_Q_CAMERA=0
# UNO_Q_CAMERA=mock
UNO_Q_MOCK_FRAMES_DIR=
UNO_Q_SEEK_DEADBAND=0.08
UNO_Q_SEEK_TARGET_AREA=0.12

# --- Optional nav-assist stub (not AprilTag training) ---
UNO_Q_NAV_ASSIST=0
