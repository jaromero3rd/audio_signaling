# Reuses the installed Grok CLI login. Optional XAI_API_KEY stays private.
GROK_BIN=grok
GROK_MODEL=grok-4.7-build-fast
# A bot YOU control, installed in YOUR private announcement-following server.
# IDs alone do not authorize reading. Never use a personal Discord user token.
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=
# Explicit trusted local check commands as JSON argv arrays; no chat-supplied shell.
# Python-syntax-only policy (replace path for your installation):
# PUBLISH_CHECKS_JSON=[["python3","/absolute/path/to/grok-team/checks/python_syntax.py"]]
# Keep disabled until you select the appropriate checks for your deployment.
PUBLISH_CHECKS_JSON=[]
